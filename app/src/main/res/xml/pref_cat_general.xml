<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceScreen android:key="settings_cat_general"
    android:title="@string/settings_cat_general"
    android:summary="@string/settings_cat_general_summary">

    <PreferenceScreen
        android:icon="@drawable/ic_ruler_grey600_48dp"
        android:key="xdrip_units_settings"
        android:summary="@string/mmol_or_mgdl_high_and_low"
        android:title="@string/glucose_units">
        <PreferenceCategory
            android:key="bgRange"
            android:title="@string/general_settings">
            <ListPreference
                android:defaultValue="mgdl"
                android:entries="@array/bgUnitEntries"
                android:entryValues="@array/bgUnitValues"
                android:key="units"
                android:title="@string/glucose_units" />
            <EditTextPreference
                android:defaultValue="170"
                android:inputType="numberDecimal"
                android:key="highValue"
                android:summary="@string/maximum_value"
                android:title="@string/high_value" />
            <EditTextPreference
                android:defaultValue="70"
                android:inputType="numberDecimal"
                android:key="lowValue"
                android:summary="@string/minimum_value"
                android:title="@string/low_value" />
        </PreferenceCategory>
    </PreferenceScreen>

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="plus_show_reminders"
        android:summary="@string/show_reminder_features"
        android:title="@string/enable_reminder_features" />

    <Preference
        android:key="reminders_settings"
        android:summary="@string/show_reminder_features"
        android:title="@string/reminders">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.eveningoutpost.dexdrip.Reminders"
            android:targetPackage="@string/local_target_package" />
    </Preference>

    <Preference
        android:key="emergency_messages_settings"
        android:title="@string/title_emergency_messages">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.eveningoutpost.dexdrip.eassist.EmergencyAssistActivity"
            android:targetPackage="@string/local_target_package" />
    </Preference>

    <PreferenceScreen
        android:key="Notification_Channels_screen"
        android:title="@string/category_notifications">
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="high_priority_notifications"
            android:summary="@string/summary_high_priority_notifications"
            android:title="@string/title_high_priority_notifications" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="public_notifications"
            android:summary="@string/summary_public_notifications"
            android:title="@string/title_public_notifications" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ongoing_notification_aodchipstyle"
            android:summary="Display notification chip and lockscreen notification. Android 16+ only"
            android:title="Use AOD chip style" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="compact_persistent_notification"
            android:summary="@string/summary_compact_ongoing_notification"
            android:title="@string/title_compact_ongoing_notification" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:dependency="engineering_mode"
            android:key="use_proper_ongoing"
            android:summary="Use proper ongoing notification. Disabling this causes collector problems on Android 8+"
            android:title="Proper ongoing" />
    </PreferenceScreen>

    <PreferenceScreen
        android:key="xdrip_language_settings"
        android:title="@string/title_language">
        <SwitchPreference
            android:defaultValue="false"
            android:key="force_english"
            android:summary="@string/using_local_language"
            android:summaryOn="@string/forcing_alternate_language"
            android:switchTextOff="@string/short_off_text_for_switches"
            android:switchTextOn="@string/short_on_text_for_switches"
            android:title="@string/force_english_text" />
        <ListPreference
            android:defaultValue="en"
            android:entries="@array/LocaleChoices"
            android:entryValues="@array/LocaleChoicesValues"
            android:key="forced_language"
            android:summary="@string/need_alternate_language"
            android:title="@string/chosse_language" />
    </PreferenceScreen>
    </PreferenceScreen>
</PreferenceScreen>
